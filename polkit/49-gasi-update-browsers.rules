// Izinkan member group "sudo" menjalankan updateChrome/updateFirefox lewat
// pkexec tanpa diminta password, supaya bisa dipanggil di background.
polkit.addRule(function(action, subject) {
    var allowed = ["/usr/local/bin/updateChrome", "/usr/local/bin/updateFirefox"];
    if (action.id == "org.freedesktop.policykit.exec" &&
        allowed.indexOf(action.lookup("program")) !== -1 &&
        subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
